TITLE: Lin ri-explicit;
synthetic panel seed 741920;
DATA: FILE = panel.dat;
VARIABLE: NAMES = x1-x3 y1-y3;
ANALYSIS: ESTIMATOR = ML;
MODEL = NOCOV;
MODEL: RIx BY x1-x3@1;
RIy BY y1-y3@1;
wx1 BY x1@1;
wx2 BY x2@1;
wx3 BY x3@1;
wy1 BY y1@1;
wy2 BY y2@1;
wy3 BY y3@1;
x1-y3@0;
wx2 wy2 ON wx1 wy1;
wx3 wy3 ON wx2 wy2;
RIx WITH RIy;
wx1 WITH wy1;
wx2 WITH wy2;
wx3 WITH wy3;
OUTPUT: STDYX TECH1;
